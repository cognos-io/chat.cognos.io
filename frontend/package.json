{
  "dependencies": {
    "@angular/animations": "^21.2.16",
    "@angular/cdk": "^21.2.14",
    "@angular/common": "^21.2.16",
    "@angular/compiler": "^21.2.16",
    "@angular/core": "^21.2.16",
    "@angular/forms": "^21.2.16",
    "@angular/platform-browser": "^21.2.16",
    "@angular/platform-browser-dynamic": "^21.2.16",
    "@angular/router": "^21.2.16",
    "@cognos/ui": "workspace:*",
    "@cognos/ui-angular": "workspace:*",
    "argon2id": "^1.0.1",
    "blakejs": "^1.2.1",
    "clipboard": "^2.0.11",
    "emoji-toolkit": "^8.0.0",
    "js-base64": "^3.7.7",
    "katex": "^0.16.10",
    "marked": "^18.0.5",
    "mermaid": "^11.15.0",
    "ngx-infinite-scroll": "^21.0.0",
    "ngx-markdown": "^21.3.0",
    "ngxtension": "^3.2.0",
    "openai": "4.52.0",
    "pocketbase": "^0.21.3",
    "prismjs": "^1.30.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "tweetnacl": "^1.0.3",
    "zod": "^3.22.4",
    "zone.js": "~0.16.2"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^21.2.14",
    "@angular-eslint/builder": "^21.4.0",
    "@angular-eslint/eslint-plugin": "^21.4.0",
    "@angular-eslint/eslint-plugin-template": "^21.4.0",
    "@angular-eslint/schematics": "^21.4.0",
    "@angular-eslint/template-parser": "^21.4.0",
    "@angular/build": "^21.2.14",
    "@angular/cli": "^21.2.14",
    "@angular/compiler-cli": "^21.2.16",
    "@angular/localize": "^21.2.16",
    "@tailwindcss/typography": "^0.5.12",
    "@trivago/prettier-plugin-sort-imports": "^4.3.0",
    "@types/node": "^25.9.1",
    "@typescript-eslint/eslint-plugin": "^7.2.0",
    "@typescript-eslint/parser": "^7.2.0",
    "autoprefixer": "^10.4.18",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "husky": "^9.0.11",
    "jsdom": "^29.1.1",
    "lint-staged": "^15.2.2",
    "pocketbase-typegen": "^1.2.1",
    "postcss": "^8.4.36",
    "prettier": "^3.2.5",
    "prettier-plugin-tailwindcss": "^0.5.13",
    "tailwindcss": "^3.4.1",
    "ts-node": "^10.9.2",
    "typescript": "~5.9.3",
    "vitest": "^4.1.8"
  },
  "name": "@cognos/chat",
  "prettier": {
    "importOrder": [
      "^@angular/(.*)$",
      "^pocketbase(.*)$",
      "^rxjs(.*)$",
      "<THIRD_PARTY_MODULES>",
      "^@cognos/(.*)$",
      "^@app/(.*)$",
      "^@components/(.*)$",
      "^@environments/(.*)$",
      "^@guards/(.*)$",
      "^@interfaces/(.*)$",
      "^@pages/(.*)$",
      "^@services/(.*)$",
      "^[./]"
    ],
    "importOrderParserPlugins": [
      "typescript",
      "decorators"
    ],
    "importOrderSeparation": true,
    "importOrderSortSpecifiers": true,
    "plugins": [
      "@trivago/prettier-plugin-sort-imports",
      "prettier-plugin-tailwindcss"
    ],
    "printWidth": 88,
    "semi": true,
    "singleQuote": true,
    "tabWidth": 2,
    "trailingComma": "all"
  },
  "private": true,
  "scripts": {
    "build": "ng build",
    "extract-i18n": "ng extract-i18n --output-path=src/locale --format=xlf2",
    "format": "prettier --write \"src/**/*.{ts,js,json,html,scss,css,md}\"",
    "lint": "ng lint --fix",
    "lint-staged": "lint-staged",
    "ng": "ng",
    "start": "ng serve",
    "test": "ng test",
    "typegen": "pocketbase-typegen --db ../backend/pb_data/data.db --out ./src/app/types/pocketbase-types.ts",
    "watch": "ng build --watch --configuration development",
    "prepare": "./scripts/prepare.sh"
  },
  "version": "0.0.0",
  "lint-staged": {
    "*.{js,ts}": "eslint --cache --fix",
    "*.{ts,js,json,html,scss,css,md}": "prettier --write"
  },
  "scarfSettings": {
    "enabled": false
  },
  "packageManager": "pnpm@10.33.0"
}
