---
// Prefixed locales: /de/privacy, /fr/privacy, …
import LegalPage from '../../components/LegalPage.astro';
import { nonDefaultLocales, type Lang } from '../../i18n/ui';

export function getStaticPaths() {
  return nonDefaultLocales.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: Lang };
---

<LegalPage lang={lang} page="privacy" />
