---
// Prefixed locales: /de/business, /fr/business, …
import BusinessPage from '../../components/BusinessPage.astro';
import { nonDefaultLocales, type Lang } from '../../i18n/ui';

export function getStaticPaths() {
  return nonDefaultLocales.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: Lang };
---

<BusinessPage lang={lang} />
