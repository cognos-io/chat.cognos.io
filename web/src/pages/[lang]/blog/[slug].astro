---
// Prefixed locales: /de/blog/<slug>, /fr/blog/<slug>, …
import BlogPost from '../../../components/BlogPost.astro';
import { blogSlugs } from '../../../lib/blog';
import { nonDefaultLocales, type Lang } from '../../../i18n/ui';

export function getStaticPaths() {
  return nonDefaultLocales.flatMap((lang) =>
    blogSlugs.map((slug) => ({ params: { lang, slug } })),
  );
}

const { lang, slug } = Astro.params as { lang: Lang; slug: string };
---

<BlogPost lang={lang} slug={slug} />
