---
// Prefixed locales: /de/blog, /fr/blog, …
import BlogIndex from '../../../components/BlogIndex.astro';
import { nonDefaultLocales, type Lang } from '../../../i18n/ui';

export function getStaticPaths() {
  return nonDefaultLocales.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: Lang };
---

<BlogIndex lang={lang} />
