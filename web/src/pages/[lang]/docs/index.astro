---
// Prefixed locales: /de/docs, /fr/docs, …
import DocsPage from '../../../components/DocsPage.astro';
import { nonDefaultLocales, type Lang } from '../../../i18n/ui';

export function getStaticPaths() {
  return nonDefaultLocales.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: Lang };
---

<DocsPage lang={lang} slug="index" />
