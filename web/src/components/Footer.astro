---
import Icon from './Icon.astro';
import Logo from './Logo.astro';
import {
  homeAnchor,
  languages,
  locales,
  localizedPath,
  type Lang,
  type Translator,
} from '../i18n/ui';

interface Props {
  t: Translator;
  lang: Lang;
  /** Logical path of the current page, for building the language links. */
  path?: string;
}
const { t, lang, path = '/' } = Astro.props;
const anchor = (hash: string) => homeAnchor(lang, path, hash);
const page = (p: string) => localizedPath(lang, p);
const year = new Date().getFullYear();
---

<footer>
  <div class="wrap">
    <div class="footer-grid">
      <div>
        <a class="brand" href={anchor('#top')} aria-label="Cognos"><Logo class="brand-logo" /></a>
        <p class="fdesc">{t('footer.desc')}</p>
      </div>
      <div>
        <h2 class="footer-heading">{t('footer.product.heading')}</h2>
        <a class="flink" href={anchor('#features')}>{t('footer.product.features')}</a>
        <a class="flink" href={anchor('#how')}>{t('footer.product.how')}</a>
        <a class="flink" href={anchor('#compare')}>{t('footer.product.compare')}</a>
        <a class="flink" href={anchor('#audience')}>{t('footer.product.pricing')}</a>
      </div>
      <div>
        <h2 class="footer-heading">{t('footer.security.heading')}</h2>
        <a class="flink" href={anchor('#security')}>{t('footer.security.audits')}</a>
        <a class="flink" href={anchor('#security')}>{t('footer.security.protocol')}</a>
        <a class="flink" href={anchor('#security')}>{t('footer.security.keyVerification')}</a>
        <a class="flink" href={anchor('#audience')}>{t('footer.security.onprem')}</a>
      </div>
      <div>
        <h2 class="footer-heading">{t('footer.company.heading')}</h2>
        <a class="flink" href={anchor('#top')}>{t('footer.company.about')}</a>
        <a class="flink" href={page('/privacy')}>{t('footer.company.privacy')}</a>
        <a class="flink" href={page('/terms')}>{t('footer.company.terms')}</a>
        <a class="flink" href={page('/contact')}>{t('footer.company.contact')}</a>
      </div>
    </div>

    <nav class="lang-switch" aria-label={t('footer.language')}>
      <Icon name="Languages" size={14} />
      {
        locales.map((code) => (
          <a
            href={localizedPath(code, path)}
            hreflang={code}
            lang={code}
            aria-current={code === lang ? 'true' : undefined}
          >
            {languages[code]}
          </a>
        ))
      }
    </nav>

    <div class="fbottom">
      <span>{t('footer.copyright', { year })}</span>
      <span class="kl"><Icon name="ShieldCheck" size={13} /> {t('footer.killer')}</span>
    </div>
  </div>
</footer>
