---
import Icon from './Icon.astro';
import type { Translator } from '../i18n/ui';

interface Props {
  t: Translator;
}
const { t } = Astro.props;
const items = t.raw<{ title: string; body: string }[]>('security.items');
const icons = ['FileLock2', 'Ban', 'Landmark', 'KeyRound'] as const;
---

<section class="sec-pad" id="security">
  <div class="wrap">
    <div class="split">
      <div class="reveal">
        <span class="eyebrow text-brand">{t('security.eyebrow')}</span>
        <h2 class="sec-h mt-100">{t('security.title')}</h2>
        <p class="lead-copy">
          {t('security.lead')}
        </p>
      </div>
      <div>
        <div class="grid grid--sm-2 grid--compact">
          {
            items.map((item, i) => (
              <div class="reveal">
                <div class="fcard">
                  <div class="ficon"><Icon name={icons[i]} size={22} /></div>
                  <h3>{item.title}</h3>
                  <p>{item.body}</p>
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</section>
