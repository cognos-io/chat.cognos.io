---
import TextPage from './TextPage.astro';
import LegalBlock from './LegalBlock.astro';
import { localizedPath, useTranslations, type Lang } from '../i18n/ui';
import type { LegalBlock as Block, LegalSection } from '../lib/legal';

interface Props {
  lang: Lang;
  /** Which standalone page to render — keys live under `pages.<page>`. */
  page: 'privacy' | 'terms';
}
const { lang, page } = Astro.props;
const t = useTranslations(lang);
const base = `pages.${page}`;
const path = `/${page}`;

const intro = t.raw<Block[]>(`${base}.intro`) ?? [];
const sections = t.raw<LegalSection[]>(`${base}.sections`) ?? [];

interface Fact {
  label: string;
  value: string;
}
const facts = t.raw<Fact[]>(`${base}.facts`) ?? [];

const legalTabs = [
  {
    label: t('pages.privacy.title'),
    href: localizedPath(lang, '/privacy'),
    current: page === 'privacy',
  },
  {
    label: t('pages.terms.title'),
    href: localizedPath(lang, '/terms'),
    current: page === 'terms',
  },
];
const asideItems = sections.map((section, index) => ({
  label: section.heading,
  href: `#section-${index + 1}`,
}));
const navLabel = t(`${base}.eyebrow`);
---

<TextPage
  lang={lang}
  title={t(`${base}.metaTitle`)}
  description={t(`${base}.metaDescription`)}
  heading={t(`${base}.title`)}
  path={path}
  eyebrow={t(`${base}.eyebrow`)}
  lead={t(`${base}.lead`)}
  navLabel={navLabel}
  tabs={legalTabs}
  asideItems={asideItems}
  facts={facts}
  updatedLabel={t(`${base}.effectiveLabel`)}
  updatedValue={t(`${base}.effectiveDate`)}
  t={t}
>
  {
    intro.length > 0 && (
      <div class="text-page__intro">
        {intro.map((block) => (
          <LegalBlock block={block} />
        ))}
      </div>
    )
  }
  {
    sections.map((section, index) => (
      <section id={`section-${index + 1}`}>
        <h2>
          <span class="text-page__section-number">{index + 1}</span>
          {section.heading}
        </h2>
        {section.blocks.map((block) => (
          <LegalBlock block={block} />
        ))}
      </section>
    ))
  }
</TextPage>
