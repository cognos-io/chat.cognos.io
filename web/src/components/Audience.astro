---
import Icon from './Icon.astro';
import { SIGN_UP_URL } from '../config';
import { localizedPath, type Lang, type Translator } from '../i18n/ui';

interface Props {
  t: Translator;
  lang: Lang;
}
const { t, lang } = Astro.props;
// List copy carries light inline <b> emphasis; these are trusted, static,
// author-controlled strings rendered with set:html.
const indItems = t.raw<string[]>('audience.individuals.items');
const bizItems = t.raw<string[]>('audience.business.items');
---

<section class="sec-pad" id="audience">
  <div class="wrap">
    <div class="sec-head reveal">
      <span class="eyebrow">{t('audience.eyebrow')}</span>
      <h2 class="sec-h">
        {t('audience.titleLine1')}<br />{t('audience.titleLine2')}
      </h2>
      <p>{t('audience.lead')}</p>
    </div>

    <div class="grid grid--2 section-grid price-grid">
      <!-- Pay as you go -->
      <div class="reveal">
        <div class="price-card">
          <div class="price-head">
            <span class="ficon"><Icon name="Gauge" size={22} /></span>
            <h3>{t('audience.individuals.title')}</h3>
          </div>
          <div class="price-figure">
            <span class="price-cur">{t('audience.individuals.currency')}</span>
            <span class="price-amt">{t('audience.individuals.amount')}</span>
            <span class="price-per">{t('audience.individuals.period')}</span>
          </div>
          <p class="price-sub">{t('audience.individuals.tagline')}</p>
          <p class="price-vat">{t('audience.vatNote')}</p>
          <ul class="price-list">
            {
              indItems.map((item) => (
                <li>
                  <Icon name="Check" size={18} /> <span set:html={item} />
                </li>
              ))
            }
          </ul>
          <a class="btn btn-lg btn-outline price-cta" href={SIGN_UP_URL}>
            {t('audience.individuals.cta')}
          </a>
        </div>
      </div>

      <!-- Unlimited -->
      <div class="reveal">
        <div class="price-card price-card--featured">
          <div class="price-head">
            <span class="ficon"><Icon name="Infinity" size={22} /></span>
            <h3>{t('audience.business.title')}</h3>
            <span class="price-badge">
              <Icon name="Sparkles" size={12} /> {t('audience.business.badge')}
            </span>
          </div>
          <div class="price-figure">
            <span class="price-cur">{t('audience.business.currency')}</span>
            <span class="price-amt">{t('audience.business.amount')}</span>
            <span class="price-per">{t('audience.business.period')}</span>
          </div>
          <p class="price-sub" set:html={t('audience.business.annual')} />
          <p class="price-vat">{t('audience.vatNote')}</p>
          <ul class="price-list">
            {
              bizItems.map((item) => (
                <li>
                  <Icon name="Check" size={18} /> <span set:html={item} />
                </li>
              ))
            }
          </ul>
          <a class="btn btn-lg price-cta price-cta--featured" href={SIGN_UP_URL}>
            {t('audience.business.cta')}
          </a>
        </div>
      </div>
    </div>

    <p class="roadmap-note reveal">
      {t('audience.roadmap')}<a class="roadmap-link" href={localizedPath(lang, '/business')}
        >{t('audience.roadmapLink')}</a
      >{t('audience.roadmapAfter')}
    </p>
  </div>
</section>
