---
import Icon from './Icon.astro';
import Logo from './Logo.astro';
import { SIGN_IN_URL, SIGN_UP_URL } from '../config';
import { homeAnchor, type Lang, type Translator } from '../i18n/ui';

interface Props {
  t: Translator;
  lang: Lang;
  /** Logical path of the current page, so section links can point back home. */
  path?: string;
}
const { t, lang, path = '/' } = Astro.props;
const anchor = (hash: string) => homeAnchor(lang, path, hash);
---

<nav class="navbar" data-open="false">
  <div class="wrap navbar__inner">
    <a class="brand" href={anchor('#top')} aria-label="Cognos"><Logo class="brand-logo" /></a>

    <button
      class="nav-toggle"
      type="button"
      aria-expanded="false"
      aria-label="Toggle navigation"
    >
      <Icon name="Menu" size={22} />
    </button>

    <div class="nav-center">
      <ul class="nav-links">
        <li><a class="nav-link" href={anchor('#how')}>{t('nav.how')}</a></li>
        <li><a class="nav-link" href={anchor('#compare')}>{t('nav.compare')}</a></li>
        <li><a class="nav-link" href={anchor('#features')}>{t('nav.features')}</a></li>
        <li><a class="nav-link" href={anchor('#audience')}>{t('nav.pricing')}</a></li>
        <li><a class="nav-link" href={anchor('#security')}>{t('nav.security')}</a></li>
      </ul>
    </div>

    <div class="nav-actions">
      <a class="btn btn-outline" href={SIGN_IN_URL}>{t('nav.signIn')}</a>
      <a class="btn btn-primary" href={SIGN_UP_URL}>
        <Icon name="Lock" size={17} /> {t('nav.cta')}
      </a>
    </div>
  </div>
</nav>
