---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from './Navbar.astro';
import Hero from './Hero.astro';
import Contrast from './Contrast.astro';
import HowItWorks from './HowItWorks.astro';
import Features from './Features.astro';
import Audience from './Audience.astro';
import Security from './Security.astro';
import Cta from './Cta.astro';
import Footer from './Footer.astro';
import { useTranslations, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
---

<BaseLayout lang={lang} title={t('meta.title')} description={t('meta.description')} path="/">
  <Navbar t={t} lang={lang} path="/" />
  <main>
    <Hero t={t} />
    <Contrast t={t} />
    <HowItWorks t={t} />
    <Features t={t} />
    <Audience t={t} lang={lang} />
    <Security t={t} />
    <Cta t={t} />
  </main>
  <Footer t={t} lang={lang} path="/" />
</BaseLayout>
