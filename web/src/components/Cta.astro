---
import Icon from './Icon.astro';
import { signUpUrl } from '../config';
import { localizedPath } from '../i18n/ui';
import type { Lang, Translator } from '../i18n/ui';

interface Props {
  t: Translator;
  lang: Lang;
}
const { t, lang } = Astro.props;
---

<section class="section-tail" id="cta">
  <div class="wrap">
    <div class="cta-band reveal">
      <div class="glow"></div>
      <h2>
        {t('cta.titleBefore')}<br />{t('cta.titleMake')}{' '}
        <span class="em">{t('cta.titleEm')}</span>
      </h2>
      <p>{t('cta.lead')}</p>
      <div class="btns">
        <a
          class="btn btn-lg btn-light2"
          href={signUpUrl('cta_individuals')}
          data-track="cta_click"
          data-track-location="cta_individuals"
          data-track-target="signup"
        >
          <Icon name="Lock" size={17} /> {t('cta.individuals')}
        </a>
        <a
          class="btn btn-lg btn-ghost2"
          href={localizedPath(lang, '/business')}
          data-track="cta_click"
          data-track-location="cta_business"
          data-track-target="business"
        >
          <Icon name="ArrowRight" size={17} /> {t('cta.business')}
        </a>
      </div>
    </div>
  </div>
</section>
