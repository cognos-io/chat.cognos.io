---
import '../styles/content-blocks.css';
import Icon from './Icon.astro';
import Slideshow from './Slideshow.astro';
import { localizeHtml, type DocsBlock } from '../lib/docs';
import { resolveMedia } from '../lib/media';
import { useTranslations, type Lang } from '../i18n/ui';

interface Props {
  block: DocsBlock;
  lang: Lang;
  /**
   * Make figures open in the page's lightbox. Requires `Lightbox.astro` on the
   * page, so it is opt-in: docs pages render plain figures, blog posts zoom.
   * `gallery` blocks are always zoomable - the slideshow crops hard by design.
   */
  zoomable?: boolean;
}
const { block, lang, zoomable = false } = Astro.props;
const t = useTranslations(lang);
/** Localize internal links in trusted HTML before rendering with set:html. */
const h = (html: string) => localizeHtml(html, lang);

// A figure renders only once its image exists under public/ (see lib/media.ts),
// so a page authored ahead of its screenshots stays clean.
const figureSrc = 'figure' in block ? resolveMedia(block.figure.src, lang) : null;

// Callout variants map to a tint + a leading icon. `security` is the strongest,
// reserved for "you can lose your data" warnings around the Account Key.
const noteIcons: Record<string, string> = {
  tip: 'Lightbulb',
  info: 'Info',
  warning: 'TriangleAlert',
  security: 'ShieldAlert',
};
---

{'p' in block && <p set:html={h(block.p)} />}

{'h3' in block && <h3 set:html={h(block.h3)} />}

{
  'ul' in block && (
    <ul>
      {block.ul.map((item) => (
        <li set:html={h(item)} />
      ))}
    </ul>
  )
}

{
  'steps' in block && (
    <ol class="docs-steps">
      {block.steps.map((step) => (
        <li class="docs-step">
          <p class="docs-step__title" set:html={h(step.title)} />
          {step.body && <p class="docs-step__body" set:html={h(step.body)} />}
        </li>
      ))}
    </ol>
  )
}

{
  'note' in block &&
    (() => {
      const variant = block.note.variant ?? 'tip';
      return (
        <aside class:list={['docs-note', `docs-note--${variant}`]}>
          <span class="docs-note__icon" aria-hidden="true">
            <Icon name={noteIcons[variant] as any} size={18} />
          </span>
          <div class="docs-note__body">
            {block.note.title && <p class="docs-note__title" set:html={h(block.note.title)} />}
            <p set:html={h(block.note.body)} />
          </div>
        </aside>
      );
    })()
}

{
  'figure' in block && figureSrc && (
    <figure class="docs-figure">
      {zoomable ? (
        /* A standalone figure is its own lightbox group, keyed by src so two
           figures on one page never browse into each other. */
        <button
          type="button"
          class="zoom-trigger"
          data-lightbox={`figure-${figureSrc}`}
          aria-label={t('a11y.media.enlarge', { alt: block.figure.alt })}
        >
          <img src={figureSrc} alt={block.figure.alt} loading="lazy" decoding="async" />
        </button>
      ) : (
        <img src={figureSrc} alt={block.figure.alt} loading="lazy" decoding="async" />
      )}
      {block.figure.caption && <figcaption set:html={block.figure.caption} />}
    </figure>
  )
}

{
  'gallery' in block && (
    <Slideshow lang={lang} label={block.gallery.label} images={block.gallery.images} />
  )
}

{
  'table' in block && (
    <div class="text-page__table-wrap">
      <table class="text-page__table">
        <thead>
          <tr>
            {block.table.head.map((cell) => (
              <th scope="col" set:html={cell} />
            ))}
          </tr>
        </thead>
        <tbody>
          {block.table.rows.map((row) => (
            <tr>
              {row.map((cell) => (
                <td set:html={cell} />
              ))}
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  )
}

{
  'cards' in block && (
    <div class="docs-cards">
      {block.cards.map((card) => (
        <a class="docs-card" href={card.to}>
          {card.icon && (
            <span class="docs-card__icon" aria-hidden="true">
              <Icon name={card.icon as any} size={20} />
            </span>
          )}
          <span class="docs-card__title" set:html={card.title} />
          <span class="docs-card__body" set:html={card.body} />
        </a>
      ))}
    </div>
  )
}
