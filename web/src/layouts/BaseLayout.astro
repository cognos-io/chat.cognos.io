---
import '../styles/tokens.css';
import '../styles/home.css';
import { bcp47, locales, localizedPath, useTranslations, type Lang } from '../i18n/ui';
import { hasMdRoute } from '../lib/md-routes';
import { markdownPath } from '../lib/markdown';

export interface Props {
  lang: Lang;
  title: string;
  description: string;
  /** Logical path (locale-agnostic) for building hreflang alternates. */
  path?: string;
  /** `article` for blog posts, so shares render as editorial rather than a site. */
  ogType?: 'website' | 'article';
  /** Blog-post metadata, emitted as `article:*` tags when `ogType` is article. */
  article?: {
    /** Absolute ISO publication date (`YYYY-MM-DD`). */
    published: string;
    /** Author's personal name. */
    author: string;
  };
}

const { lang, title, description, path = '/', ogType = 'website', article } = Astro.props;
const t = useTranslations(lang);
const site = Astro.site;
const canonical = site ? new URL(localizedPath(lang, path), site).href : undefined;

// Open Graph wants territories underscored (`en_GB`); the shared BCP 47 map
// spells them with a hyphen for `Intl`.
const ogLocales = Object.fromEntries(
  Object.entries(bcp47).map(([code, tag]) => [code, tag.replace('-', '_')]),
) as Record<Lang, string>;
---

<!doctype html>
<html lang={lang} data-theme="light" data-accent="emerald">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    {canonical && <link rel="canonical" href={canonical} />}

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="Cognos" />
    {canonical && <meta property="og:url" content={canonical} />}
    {
      ogType === 'article' && article && (
        <>
          <meta property="article:published_time" content={article.published} />
          <meta property="article:author" content={article.author} />
        </>
      )
    }
    <meta property="og:locale" content={ogLocales[lang]} />
    {
      locales
        .filter((code) => code !== lang)
        .map((code) => <meta property="og:locale:alternate" content={ogLocales[code]} />)
    }
    <meta name="twitter:card" content="summary" />

    {
      /* Privacy-friendly analytics - production builds only. Site-specific
         script hash from Plausible; queue shim + init let track() calls fire
         before the async script has loaded. */
      import.meta.env.PROD && (
        <>
          <script async src="https://plausible.io/js/pa-FxSv3tmVTFctFy6HFBkoB.js" is:inline />
          <script is:inline>
            window.plausible =
              window.plausible ||
              function () {
                (plausible.q = plausible.q || []).push(arguments);
              };
            plausible.init = plausible.init || function (i) {
              plausible.o = i || {};
            };
            plausible.init();
          </script>
        </>
      )
    }

    {
      /* hreflang alternates so search engines pair up the six locales. */
      site &&
        locales.map((code) => (
          <link
            rel="alternate"
            hreflang={code}
            href={new URL(localizedPath(code, path), site).href}
          />
        ))
    }
    {
      site && (
        <link
          rel="alternate"
          hreflang="x-default"
          href={new URL(localizedPath('en', path), site).href}
        />
      )
    }

    {
      /* The page's markdown twin, for agents that would rather read prose than
         parse a layout. `/llms.txt` indexes them all.

         Gated on the raw prop rather than the `/` default: the 404 page passes
         no path, and must not advertise the homepage's twin as its own. */
      site && Astro.props.path && hasMdRoute(Astro.props.path) && (
        <link
          rel="alternate"
          type="text/markdown"
          href={new URL(markdownPath(path, lang), site).href}
        />
      )
    }

    {/* Page-specific head tags - the blog uses this for its feed link. */}
    <slot name="head" />
  </head>
  <body>
    <a href="#main-content" class="skip-link">{t('a11y.skipToContent')}</a>
    <slot />

    <script>
      import { track, type EventProps, type WebAnalyticsEvent } from '../lib/analytics';

      // Declarative analytics: one delegated listener picks up every element
      // carrying data-track, with props built from its data-track-* attributes
      // (data-track-location → location, data-track-to → to, …).
      document.addEventListener('click', (e) => {
        const el = (e.target as Element).closest<HTMLElement>('[data-track]');
        if (!el?.dataset.track) return;
        const props: EventProps = {};
        for (const [key, value] of Object.entries(el.dataset)) {
          if (key === 'track' || !key.startsWith('track') || value === undefined) continue;
          const prop = key.slice('track'.length);
          props[prop.charAt(0).toLowerCase() + prop.slice(1)] = value;
        }
        track(el.dataset.track as WebAnalyticsEvent, props);
      });

      // Scroll-reveal + mobile nav. Progressive enhancement only - content is
      // fully visible without JS, and reveals are skipped when the user prefers
      // reduced motion.
      const nav = document.querySelector<HTMLElement>('.navbar');
      const toggle = document.querySelector<HTMLButtonElement>('.nav-toggle');
      toggle?.addEventListener('click', () => {
        const open = nav?.getAttribute('data-open') === 'true';
        nav?.setAttribute('data-open', String(!open));
        toggle.setAttribute('aria-expanded', String(!open));
      });

      const els = Array.from(document.querySelectorAll<HTMLElement>('.reveal'));
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (!reduce && 'IntersectionObserver' in window) {
        els.forEach((el, i) => {
          el.style.transitionDelay = `${(i % 4) * 60}ms`;
          el.classList.add('armed');
        });
        const inView = (el: Element) => {
          const r = el.getBoundingClientRect();
          return r.top < (window.innerHeight || 0) && r.bottom > 0;
        };
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((e) => {
              if (e.isIntersecting) {
                e.target.classList.add('in');
                io.unobserve(e.target);
              }
            });
          },
          { threshold: 0.1, rootMargin: '0px 0px -6% 0px' },
        );
        els.forEach((el) => (inView(el) ? el.classList.add('in') : io.observe(el)));
        setTimeout(() => els.forEach((el) => el.classList.add('in')), 1200);
      }
    </script>
  </body>
</html>
