# Cognos backend environment variables
#
# Copy this file to `.env` and fill in the values you need. All runtime config
# uses the `COGNOS_` prefix and maps onto the koanf config in
# `internal/config/api.go` (e.g. COGNOS_INFOMANIAK_PRODUCT_ID -> infomaniak.product_id).
#
# Precedence (lowest to highest):
#   1. configs/api.{development,production,local}.yaml
#   2. COGNOS_* environment variables (below)
#   3. COGNOS_*_API_KEY_FILE files (read at startup, override the value above)
#
# Every value here is OPTIONAL — only configure the providers you actually use.
# Anything containing a key/token is a SECRET: never commit a populated .env.

# --- Bifrost ------------------------------------------------------------------
# Embedded in-process. Useful local debugging levels: error, warn, info, debug.
COGNOS_BIFROST_LOG_LEVEL=error

# --- OpenAI -------------------------------------------------------------------
# API key for OpenAI (or an OpenAI-compatible endpoint).
COGNOS_OPENAI_API_KEY=sk-...
# Alternative to the above: path to a file containing the key (e.g. a mounted
# Docker/Podman/Kubernetes secret). Overrides COGNOS_OPENAI_API_KEY if set.
COGNOS_OPENAI_API_KEY_FILE=/run/secrets/openai_api_key

# --- Infomaniak (OpenAI-compatible AI proxy) ----------------------------------
COGNOS_INFOMANIAK_API_KEY=
COGNOS_INFOMANIAK_API_KEY_FILE=/run/secrets/infomaniak_api_key
# Optional full OpenAI-compatible base URL override. Leave this unset in the
# common case and let Cognos derive the correct URL from PRODUCT_ID.
# Example explicit override:
# COGNOS_INFOMANIAK_URL=https://api.infomaniak.com/2/ai/109300/openai
COGNOS_INFOMANIAK_URL=
# Infomaniak product (LLM tenant) identifier. Required unless URL is set.
COGNOS_INFOMANIAK_PRODUCT_ID=

# --- Cloudflare (Workers AI) --------------------------------------------------
COGNOS_CLOUDFLARE_ACCOUNT_ID=
COGNOS_CLOUDFLARE_API_KEY=
COGNOS_CLOUDFLARE_API_KEY_FILE=/run/secrets/cloudflare_api_key

# --- Google Gemini ------------------------------------------------------------
COGNOS_GOOGLE_API_KEY=
COGNOS_GOOGLE_API_KEY_FILE=/run/secrets/google_api_key

# --- Anthropic (Claude) -------------------------------------------------------
COGNOS_ANTHROPIC_API_KEY=sk-ant-...
COGNOS_ANTHROPIC_API_KEY_FILE=/run/secrets/anthropic_api_key
# Optional override of the Anthropic API base URL (e.g. for a proxy/gateway).
COGNOS_ANTHROPIC_URL=https://api.anthropic.com

# --- DeepInfra ----------------------------------------------------------------
COGNOS_DEEPINFRA_API_KEY=
COGNOS_DEEPINFRA_API_KEY_FILE=/run/secrets/deepinfra_api_key
COGNOS_DEEPINFRA_URL=https://api.deepinfra.com/v1/openai

# --- Billing ------------------------------------------------------------------
# Starting trial balance granted to new accounts, in Swiss Rappen (centimes).
# Must be > 0; defaults to 200 (CHF 2.00) when unset or non-positive.
COGNOS_BILLING_TRIAL_SEED_RAPPEN=200

# Fallback USD->CHF exchange rate used when the live rate is unavailable.
# NOTE: read directly via os.Getenv (no COGNOS_ prefix). Defaults to 0.88.
BILLING_FX_RATE_FALLBACK_USD_CHF=0.88

# --- Development / e2e only ---------------------------------------------------
# Port the mock AI provider (cmd/mock-ai-provider) listens on during e2e tests.
# Defaults to 18080. Not used by the main API.
E2E_AI_MOCK_PORT=18080
