# Cognos backend environment variables
#
# Copy this file to `.env` and fill in the values you need. All runtime config
# uses the `COGNOS_` prefix and maps onto the koanf config in
# `internal/config/api.go` (e.g. COGNOS_INFOMANIAK_PRODUCT_ID -> infomaniak.product_id).
#
# Precedence (lowest to highest):
#   1. configs/api.{development,production,local}.yaml
#   2. COGNOS_* environment variables (below)
#   3. COGNOS_*_API_KEY_FILE files (read at startup, override the value above)
#
# Requirements depend on enabled production features. The authoritative matrix
# is docs/deployment-interface.md. Anything containing a key/token is a SECRET:
# never commit a populated .env. Omit an optional *_FILE variable unless the
# referenced file is actually mounted; a configured but missing file fails startup.

# --- Bifrost ------------------------------------------------------------------
# Embedded in-process. Useful local debugging levels: error, warn, info, debug.
COGNOS_BIFROST_LOG_LEVEL=error

# --- Infomaniak (OpenAI-compatible AI proxy) ----------------------------------
COGNOS_INFOMANIAK_API_KEY=
COGNOS_INFOMANIAK_API_KEY_FILE=/run/secrets/infomaniak_api_key
# Optional full OpenAI-compatible base URL override. Leave this unset in the
# common case and let Cognos derive the correct URL from PRODUCT_ID.
# Example explicit override:
# COGNOS_INFOMANIAK_URL=https://api.infomaniak.com/2/ai/109300/openai
COGNOS_INFOMANIAK_URL=
# Infomaniak product (LLM tenant) identifier. Required unless URL is set.
COGNOS_INFOMANIAK_PRODUCT_ID=

# --- Requesty (OpenAI-compatible EU gateway) ----------------------------------
# Zero-data-retention LLM router hosted in Frankfurt (AWS eu-central-1).
COGNOS_REQUESTY_API_KEY=
COGNOS_REQUESTY_API_KEY_FILE=
# Optional base URL override. Leave unset to use the EU gateway, which keeps
# Requesty's processing in-region. Full EU residency also requires EU-region
# model ids (e.g. bedrock/claude-...@eu-central-1) in the catalogue.
# Default when unset: https://router.eu.requesty.ai
# NB: do NOT append "/v1" — the gateway adds the OpenAI path itself.
COGNOS_REQUESTY_URL=
# Scheduled catalogue sync safety override. Keep false for normal operation.
COGNOS_REQUESTY_FORCE_DISABLE_ABSENT=false

# Optional approved redirect prefix for resolving model grounding citations.
COGNOS_GATEWAY_GROUNDING_REDIRECT_PREFIX=

# --- Billing ------------------------------------------------------------------
# Starting trial balance granted to new accounts, in Swiss Rappen (centimes).
# Must be > 0; defaults to 200 (CHF 2.00) when unset or non-positive.
COGNOS_BILLING_TRIAL_SEED_RAPPEN=200
COGNOS_BILLING_PAYG_MIN_COMMIT_RAPPEN=1500
COGNOS_BILLING_UNLIMITED_FAIR_USE_ALERT_RAPPEN=
# Markup in basis points (2200 = 22%).
COGNOS_BILLING_MARGIN_BPS=2200
# Micro-rappen charged at minimum for each provider web search.
COGNOS_BILLING_WEB_SEARCH_FLOOR_MICRO_RAPPEN=1100000

# Fallback USD->CHF exchange rate used when the live rate is unavailable.
# NOTE: read directly via os.Getenv (no COGNOS_ prefix). Defaults to 0.88.
BILLING_FX_RATE_FALLBACK_USD_CHF=0.88

# --- Paddle billing -----------------------------------------------------------
# Required together when paid billing is enabled. Use mounted files for both
# secrets in production; direct secret values are local-development only.
COGNOS_PADDLE_API_BASE=https://api.paddle.com
COGNOS_PADDLE_API_KEY=
COGNOS_PADDLE_API_KEY_FILE=
COGNOS_PADDLE_WEBHOOK_SECRET=
COGNOS_PADDLE_WEBHOOK_SECRET_FILE=
COGNOS_PADDLE_PRICE_PAYG=
COGNOS_PADDLE_PRICE_PAYG_OVERAGE=
COGNOS_PADDLE_PRICE_UNLIMITED_MONTHLY=
COGNOS_PADDLE_PRICE_UNLIMITED_ANNUAL=

# --- MFA ----------------------------------------------------------------------
# Required when authenticator-app MFA is enabled. Value is base64 of exactly
# 32 random bytes. Use the mounted file form in production.
COGNOS_MFA_TOTP_ENCRYPTION_KEY=
COGNOS_MFA_TOTP_ENCRYPTION_KEY_FILE=

# --- Development / e2e only ---------------------------------------------------
# Port the mock AI provider (cmd/mock-ai-provider) listens on during e2e tests.
# Defaults to 18080. Not used by the main API.
E2E_AI_MOCK_PORT=18080
