{
  "$meta": {
    "name": "Cognos Design System",
    "version": "0.1.0",
    "basedOn": "Atlassian Design System (ADS) conventions, Emerald accent",
    "description": "Design tokens for the Cognos encrypted AI chat UI library. Two themes (light, dark) and two accents (emerald [default], blue). All values extracted from the approved prototype.",
    "units": "rem for type, spacing, and radius unless noted; px for borders and shadow offsets"
  },

  "font": {
    "family": {
      "system": "-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Helvetica, Arial, sans-serif",
      "atkinson": "'Atkinson Hyperlegible', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif",
      "inter": "'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif",
      "noto": "'Noto Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif",
      "mono": "'SFMono-Regular', ui-monospace, Menlo, Consolas, monospace"
    },
    "weight": { "regular": 400, "medium": 500, "semibold": 600, "bold": 700 },
    "scale": {
      "display": {
        "size": "1.5rem",
        "lineHeight": 1.2,
        "weight": 600,
        "tracking": "-0.01em",
        "use": "empty-state hero / largest headline"
      },
      "heading.lg": {
        "size": "1.5rem",
        "lineHeight": 1.25,
        "weight": 600,
        "tracking": "-0.01em",
        "use": "project title"
      },
      "heading.md": {
        "size": "1.25rem",
        "lineHeight": 1.3,
        "weight": 600,
        "tracking": "-0.003em",
        "use": "page + dialog title"
      },
      "heading.sm": {
        "size": "1rem",
        "lineHeight": 1.35,
        "weight": 600,
        "tracking": "0",
        "use": "card / nav header title"
      },
      "body.lg": {
        "size": "0.9375rem",
        "lineHeight": 1.6,
        "weight": 400,
        "use": "chat message body"
      },
      "body": {
        "size": "0.875rem",
        "lineHeight": 1.45,
        "weight": 400,
        "use": "default UI text"
      },
      "body.sm": {
        "size": "0.8125rem",
        "lineHeight": 1.45,
        "weight": 400,
        "use": "secondary / supporting text"
      },
      "caption": {
        "size": "0.75rem",
        "lineHeight": 1.4,
        "weight": 400,
        "use": "meta, timestamps, fingerprints"
      },
      "label": {
        "size": "0.875rem",
        "lineHeight": 1.0,
        "weight": 500,
        "use": "button label"
      },
      "overline": {
        "size": "0.6875rem",
        "lineHeight": 1.4,
        "weight": 700,
        "tracking": "0.04em",
        "transform": "uppercase",
        "use": "section headers"
      },
      "lozenge": {
        "size": "0.6875rem",
        "lineHeight": 1.4,
        "weight": 700,
        "tracking": "0.02em",
        "transform": "uppercase",
        "use": "lozenge / tag text"
      }
    }
  },

  "space": {
    "0": 0,
    "025": "0.125rem",
    "050": "0.25rem",
    "075": "0.375rem",
    "100": "0.5rem",
    "150": "0.75rem",
    "200": "1rem",
    "250": "1.25rem",
    "300": "1.5rem",
    "400": "2rem",
    "500": "2.5rem",
    "600": "3rem",
    "800": "4rem",
    "$note": "0.5rem grid with a 0.125rem base step. Gutters: 1rem (mobile), 1.5-1.75rem (desktop content). Stack rhythm: 0.5/0.75/1/1.5rem."
  },

  "radius": {
    "xs": "0.1875rem",
    "sm": "0.25rem",
    "md": "0.5rem",
    "lg": "1rem",
    "pill": "9999px",
    "$note": "xs=buttons/controls/lozenges, sm=fields/menus/cards-inner, md=cards/dialogs, lg=bottom-sheet top corners, pill=avatars/toggles"
  },

  "elevation": {
    "raised": {
      "light": "0 1px 1px rgba(9,30,66,0.25), 0 0 1px rgba(9,30,66,0.31)",
      "dark": "0 1px 1px rgba(3,4,4,0.5), 0 0 1px rgba(3,4,4,0.6)"
    },
    "overlay": {
      "light": "0 8px 12px rgba(9,30,66,0.15), 0 0 1px rgba(9,30,66,0.31)",
      "dark": "0 8px 12px rgba(3,4,4,0.56), 0 0 1px rgba(3,4,4,0.6)"
    },
    "scrim": "rgba(9,30,66,0.54)"
  },

  "motion": {
    "duration": { "fast": "100ms", "medium": "150ms", "sheet": "260ms" },
    "easing": {
      "standard": "cubic-bezier(0.16, 1, 0.3, 1)",
      "linear": "linear"
    },
    "$note": "fast=hover/press fills, medium=overlay open/fade, sheet=bottom-sheet & drawer slide. Respect prefers-reduced-motion."
  },

  "stroke": {
    "borderWidth": {
      "thin": 1,
      "strong": 2
    },
    "$note": "thin=standard borders and dividers, strong=focus rings and selected outlines."
  },

  "icon": {
    "set": "Lucide (rendered as inline SVG, currentColor)",
    "strokeWidth": 2,
    "linecap": "round",
    "linejoin": "round",
    "sizes": { "xs": 12, "sm": 14, "md": 16, "lg": 18, "xl": 20, "2xl": 24 },
    "$note": "Color follows text role (subtle/subtlest by default, brand/accent when active). Never fill; outline only."
  },

  "color": {
    "neutral": {
      "light": {
        "appBg": "#F7F8F9",
        "navBg": "#FFFFFF",
        "surface": "#FFFFFF",
        "surfaceRaised": "#FFFFFF",
        "surfaceSunken": "#F7F8F9",
        "surfaceHover": "#F1F2F4",
        "surfacePressed": "#DCDFE4",
        "neutralBg": "#DCDFE4",
        "text": "#172B4D",
        "logo": "#343434",
        "textSubtle": "#44546F",
        "textSubtlest": "#626F86",
        "textDisabled": "#8590A2",
        "border": "#DFE1E6",
        "borderBold": "#B3B9C4",
        "inputBg": "#F7F8F9",
        "inputBgFocus": "#FFFFFF"
      },
      "dark": {
        "appBg": "#161A1D",
        "navBg": "#1D2125",
        "surface": "#1D2125",
        "surfaceRaised": "#22272B",
        "surfaceSunken": "#161A1D",
        "surfaceHover": "#22272B",
        "surfacePressed": "#282E33",
        "neutralBg": "#2C333A",
        "text": "#C7D1DB",
        "logo": "#EEF6E7",
        "textSubtle": "#9FADBC",
        "textSubtlest": "#8C9BAB",
        "textDisabled": "#738496",
        "border": "#38414A",
        "borderBold": "#454F59",
        "inputBg": "#22272B",
        "inputBgFocus": "#1D2125"
      }
    },

    "accent": {
      "emerald": {
        "light": {
          "brand": "#1F845A",
          "brandHover": "#216E4E",
          "brandPressed": "#164B35",
          "onBrand": "#FFFFFF",
          "link": "#216E4E",
          "selectedBg": "#DCFFF1",
          "selectedText": "#216E4E",
          "selectedBorder": "#1F845A"
        },
        "dark": {
          "brand": "#4BCE97",
          "brandHover": "#7EE2B8",
          "brandPressed": "#BAF3D6",
          "onBrand": "#1D2125",
          "link": "#4BCE97",
          "selectedBg": "#143A2B",
          "selectedText": "#7EE2B8",
          "selectedBorder": "#4BCE97"
        }
      },
      "blue": {
        "light": {
          "brand": "#0C66E4",
          "brandHover": "#0055CC",
          "brandPressed": "#09326C",
          "onBrand": "#FFFFFF",
          "link": "#0C66E4",
          "selectedBg": "#E9F2FF",
          "selectedText": "#0C66E4",
          "selectedBorder": "#0C66E4"
        },
        "dark": {
          "brand": "#579DFF",
          "brandHover": "#85B8FF",
          "brandPressed": "#CCE0FF",
          "onBrand": "#1D2125",
          "link": "#579DFF",
          "selectedBg": "#1C2B41",
          "selectedText": "#85B8FF",
          "selectedBorder": "#579DFF"
        }
      }
    },

    "semantic": {
      "light": {
        "success": "#22A06B",
        "successBg": "#DCFFF1",
        "successText": "#216E4E",
        "successBorder": "#7EE2B8",
        "danger": "#C9372C",
        "dangerText": "#AE2A19",
        "dangerBg": "#FFEDEB",
        "dangerBorder": "#F1C0C0",
        "warning": "#B8770B",
        "warningBg": "#FFF7D6",
        "warningText": "#8A5A00",
        "info": "#0C66E4",
        "infoBg": "#E9F2FF",
        "infoText": "#0C66E4"
      },
      "dark": {
        "success": "#4BCE97",
        "successBg": "#164B35",
        "successText": "#7EE2B8",
        "successBorder": "#216E4E",
        "danger": "#F87168",
        "dangerText": "#FF9C8F",
        "dangerBg": "#5D1F1A",
        "dangerBorder": "#AE2A19",
        "warning": "#E2B203",
        "warningBg": "#332E1B",
        "warningText": "#F5CD47",
        "info": "#579DFF",
        "infoBg": "#1C2B41",
        "infoText": "#85B8FF"
      }
    },

    "lozenge": {
      "light": {
        "neutral": { "bg": "#DCDFE4", "fg": "#44546F" },
        "blue": { "bg": "#E9F2FF", "fg": "#0055CC" },
        "green": { "bg": "#DCFFF1", "fg": "#216E4E" },
        "purple": { "bg": "#F3F0FF", "fg": "#5E4DB2" },
        "red": { "bg": "#FFEDEB", "fg": "#AE2A19" }
      },
      "dark": {
        "neutral": { "bg": "#2C333A", "fg": "#9FADBC" },
        "blue": { "bg": "#1C2B41", "fg": "#85B8FF" },
        "green": { "bg": "#164B35", "fg": "#7EE2B8" },
        "purple": { "bg": "#2B273F", "fg": "#B8ACF6" },
        "red": { "bg": "#5D1F1A", "fg": "#FF9C8F" }
      }
    }
  }
}
